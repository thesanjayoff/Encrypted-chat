# Copy to .env and fill in. .env itself is gitignored — never commit real secrets.
PORT=4000
DB_PATH=./data/server.sqlite
ATTACHMENTS_DIR=./attachments
CORS_ORIGIN=http://localhost:5173

# Generated automatically on first run and written back here if absent.
# This is a server secret (OPAQUE's server-side setup key) — treat it like a
# signing key. Rotating it invalidates every registered user's ability to log in.
OPAQUE_SERVER_SETUP=
