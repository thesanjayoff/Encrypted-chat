{
  "name": "e2e-chat",
  "private": true,
  "version": "0.1.0",
  "description": "Personal end-to-end encrypted chat — learning/portfolio project",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web"
  },
  "engines": {
    "node": ">=20"
  }
}
